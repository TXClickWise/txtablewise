    "tools": [
      {
        "name": "list_restaurants",
        "title": "List restaurants",
        "description": "List the restaurants the signed-in user has access to, with their id, name and slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "check_availability",
        "title": "Check availability",
        "description": "Check which times are still available for a date and party size. Uses the restaurant's own opening hours, closures, pacing, zones and table combinations. Always call this before creating a reservation.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Date in YYYY-MM-DD."
            },
            "party_size": {
              "type": "number",
              "description": "Number of guests."
            },
            "restaurant_id": {
              "type": "string",
              "description": "Only for users with more than one restaurant."
            }
          },
          "required": [
            "date",
            "party_size"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_reservations",
        "title": "List reservations",
        "description": "List reservations for a date (or date range) for a restaurant, ordered by start time. Cancelled reservations are excluded unless include_cancelled is true.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Date in YYYY-MM-DD. Defaults to today."
            },
            "end_date": {
              "type": "string",
              "description": "Optional end date (YYYY-MM-DD) for a range."
            },
            "restaurant_id": {
              "type": "string",
              "description": "Restaurant id; optional when the user has one restaurant."
            },
            "include_cancelled": {
              "type": "boolean"
            },
            "limit": {
              "type": "number",
              "description": "Max rows to return, default 100."
            }
          },
          "required": [
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_reservation",

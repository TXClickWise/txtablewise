          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "find_reservation",
        "title": "Find reservation",
        "description": "Find an active reservation by confirmation code, phone, email, or name plus date. Returns at most 5 minimal matches. Use this before update_reservation or cancel_reservation when you do not have a reservation id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "confirmation_code": {
              "type": "string",
              "description": "Confirmation code given to the guest."
            },
            "phone": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "first_name": {
              "type": "string"
            },
            "last_name": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "description": "Reservation date in YYYY-MM-DD."
            },
            "restaurant_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_reservation",
        "title": "Create reservation",
        "description": "Create a reservation. TableWise picks the table itself. Large groups may come back as pending approval instead of confirmed — always tell the guest exactly what status you got back, never say 'confirmed' when requires_manual_approval is true. Pass a stable idempotency_key so a retry never creates a second booking.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "Date in YYYY-MM-DD."
            },
            "time": {
              "type": "string",
              "description": "Local time HH:MM."
            },
            "party_size": {
              "type": "number"
            },
            "first_name": {
              "type": "string",
              "description": "Ask the guest for their real first name; never invent one."
            },
            "last_name": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "language": {
              "type": "string",
              "description": "nl, en, de or fr."
            },
            "special_requests": {
              "type": "string"
            },
            "dietary_notes": {
              "type": "string"
            },
            "occasion": {
              "type": "string"
            },
            "prefers_terrace": {
              "type": "boolean"
            },
            "idempotency_key": {
              "type": "string",
              "description": "Same key on a retry returns the original reservation."
            },
            "restaurant_id": {
              "type": "string"
            },
            "table_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Staff override only; requires the table.override capability."
            },
            "combination_id": {
              "type": "string",
              "description": "Staff override only; requires the table.override capability."
            }
          },
          "required": [
            "date",
            "time",
            "party_size",
            "first_name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_reservation",
        "title": "Update reservation",
        "description": "Change the date, time, party size or notes of an existing reservation through the TableWise engine. Read the new date, time and party size back to the guest and get an explicit yes before calling this (confirmed must be true). If the group becomes large, the reservation can go back to pending approval — report the returned status truthfully.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "reservation_id": {
              "type": "string"
            },
            "confirmed": {
              "type": "boolean",
              "description": "Must be true: the guest explicitly confirmed the change."
            },
            "date": {
              "type": "string",
              "description": "New date YYYY-MM-DD."
            },
            "time": {
              "type": "string",
              "description": "New local time HH:MM."
            },
            "party_size": {
              "type": "number"
            },
            "special_requests": {
              "type": "string"
            },
            "restaurant_id": {
              "type": "string"
            },
            "table_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Staff override only; requires table.override."
            },
            "combination_id": {
              "type": "string",
              "description": "Staff override only; requires table.override."
            }
          },
          "required": [
            "reservation_id",
            "confirmed"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },

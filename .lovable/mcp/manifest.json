        "inputSchema": {
          "type": "object",
          "properties": {
            "reservation_id": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "description": "Reason for the cancellation."
            },
            "confirmed": {
              "type": "boolean",
              "description": "Must be true: the guest explicitly confirmed the cancellation."
            },
            "restaurant_id": {
              "type": "string"
            }
          },
          "required": [
            "reservation_id",
            "reason",
            "confirmed"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
